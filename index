const secObs=new IntersectionObserver(es=>{
  es.forEach(e=>{ if(e.isIntersecting){
    $$('.nav a').forEach(a=>a.classList.toggle('active',a.dataset.sec===e.target.id));
  }});
},{rootMargin:'-42% 0px -52% 0px'});
