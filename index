const getCat  = id  => CATEGORIES.find(c => c.id === id);
const getProj = (c,id) => c.projects.find(p => p.id === id);
function serviceName(id){ const s = SERVICES.find(x=>x.id===id); return s ? s.name[LANG] : id; }
