function bindBackButtons(){
  $$('#projectsStage [data-back]').forEach(b=>b.addEventListener('click',()=>{
    if (b.dataset.back === 'categories'){ view.mode='categories'; view.catId=null; view.projId=null; }
    else { view.mode='category'; view.projId=null; }
    renderProjects();
  }));
}
function openCategory(id){ view.mode='category'; view.catId=id; view.projId=null; curCat=getCat(id); renderProjects(); $('#projects').scrollIntoView({behavior:'smooth'}); }
function openProject(pid){ view.mode='project'; view.projId=pid; view.slide=0; curProject=getProj(curCat,pid); renderProjects(); $('#projects').scrollIntoView({behavior:'smooth'}); }

