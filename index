        ${cat.projects.map((p,i)=>{
          const photos = p.slides.filter(s=>s.image).length;
          return `
        <div class="proj-card stage-anim" style="animation-delay:${Math.min(i,8)*55}ms" data-proj="${p.id}" role="button" tabindex="0" aria-label="${p.name.en}">
          <span class="proj-cover">${p.coverImage
            ? `<img src="${p.coverImage}" alt="${p.name.en}" loading="lazy" decoding="async">`
            : (p.logo ? `<img src="${p.logo}" alt="${p.name.en} logo" loading="lazy" decoding="async">` : `<span class="proj-cover-fallback">${cat.icon}</span>`)}</span>
          <h4>${p.name[LANG]}</h4>
          <p>${p.desc[LANG]}</p>
          <span class="proj-chips">
            ${p.solutions.length ? p.solutions.slice(0,3).map(id=>`<i>${serviceName(id)}</i>`).join('') + (p.solutions.length>3?`<i>+${p.solutions.length-3}</i>`:'') : `<i>${T()['about.f1']}</i>`}
