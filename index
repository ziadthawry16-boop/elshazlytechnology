/* ---------- interactive slider (same UX as before) ---------- */
function initSlider(){
  const p = curProject;
  if(!document.getElementById('slider')) return;
  $('#prevBtn').addEventListener('click',()=>go(-1,true));
  $('#nextBtn').addEventListener('click',()=>go(1,true));
  $$('#thumbs .thumb').forEach(t=>t.addEventListener('click',()=>{ goTo(+t.dataset.i,true); }));

  $('#slider').addEventListener('keydown',e=>{
    if(e.key==='ArrowRight'){ go(1,true); e.preventDefault(); }
    if(e.key==='ArrowLeft'){ go(-1,true); e.preventDefault(); }
  });

  let sx=0, sy=0, dragging=false;
  const slider = $('#slider');
  slider.addEventListener('touchstart',e=>{ sx=e.touches[0].clientX; sy=e.touches[0].clientY; dragging=true; pauseAuto(); },{passive:true});
  slider.addEventListener('touchend',e=>{
    if(!dragging) return; dragging=false;
    const dx=e.changedTouches[0].clientX-sx, dy=e.changedTouches[0].clientY-sy;
    if(Math.abs(dx)>48 && Math.abs(dx)>Math.abs(dy)) go(dx<0?1:-1,true);
    startAuto();
  },{passive:true});
  slider.addEventListener('mouseenter',pauseAuto);
  slider.addEventListener('mouseleave',startAuto);
  document.addEventListener('visibilitychange',()=>{ document.hidden?pauseAuto():startAuto(); });

  updateSlide(view.slide); startAuto();
}
function go(dir,user){ goTo((view.slide+dir+curProject.slides.length)%curProject.slides.length, user); }
function goTo(i,user){
  if(i===view.slide){ if(user) restartAuto(); return; }
  view.slide=i; updateSlide(i);
  if(user) restartAuto();
}
function updateSlide(i){
  $$('#slidesWrap .slide').forEach(s=>s.classList.toggle('active', +s.dataset.i===i));
  $$('#thumbs .thumb').forEach(t=>t.classList.toggle('on', +t.dataset.i===i));
  $('#countCur').textContent = String(i+1).padStart(2,'0');
  const s = curProject.slides[i];
  $('#infoIco').innerHTML = ICONS[s.icon];
  $('#infoTitle').textContent = s.title[LANG];
  $('#infoDesc').textContent  = s.desc[LANG];
  $('#infoCat').textContent   = s.category[LANG];
  const info=$('#infoTxt'); info.classList.remove('swap'); void info.offsetWidth; info.classList.add('swap');
}
function startAuto(){
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  pauseAuto();
  autoTimer=setInterval(()=>go(1,false), AUTOPLAY_MS);
}
function pauseAuto(){ if(autoTimer){ clearInterval(autoTimer); autoTimer=null; } }
function restartAuto(){ pauseAuto(); startAuto(); }

