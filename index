<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elshazly Technology — Integrated Technology &amp; Security Solutions</title>
<meta name="description" content="Elshazly Technology — Integrated Technology & Security Solutions. CCTV, Smart Systems, Networking, Fire Alarm, Interactive Displays and more.">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
/* ============================================================
   ELHAZLY TECHNOLOGY — PREMIUM INTERACTIVE PORTFOLIO
   Edit guide:
   • All text content  -> I18N object (EN/AR) + SERVICES + PROJECTS below
   • Contact info      -> CONFIG object
   • Brand accent      -> --accent variable
   ============================================================ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}

:root{
  --accent:#ff7a1a;
  --accent-soft:rgba(255,122,26,.14);
  --accent-glow:rgba(255,122,26,.35);
  --radius:20px;
  --header-h:76px;
  --ease:cubic-bezier(.22,.61,.21,1);
}
html[data-theme="dark"]{
  --bg:#0a0c10;
  --bg-2:#0e1218;
  --bg-3:#131823;
  --panel:rgba(255,255,255,.035);
  --panel-2:rgba(255,255,255,.06);
  --card:#10151d;
  --border:rgba(255,255,255,.09);
  --border-strong:rgba(255,255,255,.18);
  --text:#eef1f6;
  --muted:#97a1b0;
  --header-bg:rgba(10,12,16,.72);
  --grid-line:rgba(255,255,255,.045);
  --shadow:0 24px 60px rgba(0,0,0,.45);
  --logo-card:#0b0d11;
  --client-card:#ffffff;
  --scroll-thumb:rgba(255,255,255,.18);
}
html[data-theme="light"]{
  --bg:#f4f5f8;
  --bg-2:#ffffff;
  --bg-3:#eef0f4;
  --panel:rgba(13,18,26,.03);
  --panel-2:rgba(13,18,26,.05);
  --card:#ffffff;
  --border:rgba(13,18,26,.09);
  --border-strong:rgba(13,18,26,.18);
  --text:#141a22;
  --muted:#5b6572;
  --header-bg:rgba(255,255,255,.75);
  --grid-line:rgba(13,18,26,.05);
  --shadow:0 24px 60px rgba(20,26,34,.12);
  --logo-card:#0b0d11;
  --client-card:#ffffff;
  --scroll-thumb:rgba(13,18,26,.18);
}
html{scroll-behavior:smooth}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Inter',system-ui,sans-serif;
  font-size:16px;
  line-height:1.65;
  overflow-x:hidden;
  transition:background .45s var(--ease),color .45s var(--ease);
}
html[lang="ar"] body{font-family:'Tajawal','Inter',sans-serif;font-size:17px}
h1,h2,h3,h4,.brand-font{font-family:'Space Grotesk','Inter',sans-serif;letter-spacing:-.02em}
html[lang="ar"] h1,html[lang="ar"] h2,html[lang="ar"] h3,html[lang="ar"] h4,html[lang="ar"] .brand-font{font-family:'Tajawal',sans-serif;letter-spacing:0}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;background:none;border:none;color:inherit}
::selection{background:var(--accent);color:#fff}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}
::-webkit-scrollbar{width:10px}
::-webkit-scrollbar-thumb{background:var(--scroll-thumb);border-radius:8px}

.container{width:min(1200px,92%);margin-inline:auto}
.grad{background:linear-gradient(120deg,var(--accent),#ffb066);-webkit-background-clip:text;background-clip:text;color:transparent}
.kicker{display:inline-flex;align-items:center;gap:10px;font-size:.8rem;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)}
html[lang="ar"] .kicker{letter-spacing:.05em;font-size:.9rem}
.kicker::before{content:"";width:34px;height:1px;background:var(--accent)}
.section{padding:110px 0;scroll-margin-top:calc(var(--header-h) + 10px)}
.section-head{max-width:640px;margin-bottom:56px}
.section-head h2{font-size:clamp(1.9rem,4vw,2.8rem);font-weight:700;margin:14px 0 12px}
.section-head p{color:var(--muted)}

/* ---------- Reveal on scroll ---------- */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .9s var(--ease),transform .9s var(--ease)}
.reveal.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .reveal{opacity:1;transform:none;transition:none}
  *{animation-duration:.001s!important;transition-duration:.15s!important}
}

/* ================= HEADER ================= */
.header{
  position:fixed;inset-inline:0;top:0;z-index:100;height:var(--header-h);
  display:flex;align-items:center;
  background:transparent;border-bottom:1px solid transparent;
  transition:background .4s var(--ease),border-color .4s var(--ease),backdrop-filter .4s;
}
.header.scrolled{background:var(--header-bg);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom-color:var(--border)}
.header-inner{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo-badge{
  display:flex;align-items:center;gap:12px;flex-shrink:0;
}
.logo-card{
  width:46px;height:46px;border-radius:13px;overflow:hidden;
  background:var(--logo-card);border:1px solid var(--border-strong);
  display:grid;place-items:center;box-shadow:0 0 22px rgba(255,122,26,.18);
  transition:transform .35s var(--ease),box-shadow .35s var(--ease);
}
.logo-card img{width:82%;height:82%;object-fit:contain}
.logo-badge:hover .logo-card{transform:translateY(-2px);box-shadow:0 0 30px rgba(255,122,26,.35)}
.logo-name{display:flex;flex-direction:column;line-height:1.15}
.logo-name b{font-family:'Space Grotesk',sans-serif;font-size:.98rem;font-weight:700}
html[lang="ar"] .logo-name b{font-family:'Tajawal',sans-serif}
.logo-name span{font-size:.66rem;color:var(--muted);letter-spacing:.14em;text-transform:uppercase}
.nav{display:flex;align-items:center;gap:6px}
.nav a{
  position:relative;padding:8px 14px;font-size:.92rem;font-weight:500;color:var(--muted);
  border-radius:10px;transition:color .3s,background .3s;
}
.nav a:hover{color:var(--text);background:var(--panel-2)}
.nav a.active{color:var(--accent)}
.nav a.active::after{content:"";position:absolute;left:14px;right:14px;bottom:4px;height:2px;border-radius:2px;background:var(--accent)}
.header-tools{display:flex;align-items:center;gap:10px}
.lang-switch{display:flex;align-items:center;gap:2px;background:var(--panel);border:1px solid var(--border);border-radius:99px;padding:3px}
.lang-switch button{
  padding:6px 13px;border-radius:99px;font-size:.8rem;font-weight:600;color:var(--muted);
  transition:all .3s var(--ease);
}
.lang-switch button.on{background:var(--accent);color:#fff;box-shadow:0 0 16px var(--accent-glow)}
.icon-btn{
  width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
  background:var(--panel);border:1px solid var(--border);color:var(--muted);
  transition:all .3s var(--ease);
}
.icon-btn:hover{color:var(--accent);border-color:var(--accent-glow);transform:translateY(-1px)}
.icon-btn svg{width:18px;height:18px}
.nav-toggle{display:none}
.mobile-menu{
  position:fixed;inset:0;z-index:99;background:var(--bg);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
  opacity:0;pointer-events:none;transition:opacity .4s var(--ease);
}
.mobile-menu.open{opacity:1;pointer-events:auto}
.mobile-menu a{font-size:1.6rem;font-weight:600;font-family:'Space Grotesk',sans-serif;padding:12px;color:var(--muted);transition:color .3s,transform .3s}
html[lang="ar"] .mobile-menu a{font-family:'Tajawal',sans-serif}
.mobile-menu a:hover{color:var(--accent);transform:translateX(4px)}
body.menu-open{overflow:hidden}

/* ================= HERO ================= */
.hero{position:relative;min-height:100svh;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden}
#netCanvas{position:absolute;inset:0;width:100%;height:100%}
.hero-grid{
  position:absolute;inset:0;pointer-events:none;
  background-image:linear-gradient(var(--grid-line) 1px,transparent 1px),linear-gradient(90deg,var(--grid-line) 1px,transparent 1px);
  background-size:58px 58px;
  -webkit-mask-image:radial-gradient(ellipse 75% 65% at 50% 45%,#000 20%,transparent 75%);
  mask-image:radial-gradient(ellipse 75% 65% at 50% 45%,#000 20%,transparent 75%);
}
.hero-glow{position:absolute;inset:0;pointer-events:none;background:
  radial-gradient(600px 380px at 50% 18%,rgba(255,122,26,.12),transparent 70%),
  radial-gradient(800px 500px at 85% 90%,rgba(255,122,26,.05),transparent 70%)}
html[data-theme="light"] .hero-glow{background:
  radial-gradient(600px 380px at 50% 18%,rgba(255,122,26,.10),transparent 70%),
  radial-gradient(800px 500px at 85% 90%,rgba(255,122,26,.05),transparent 70%)}
.hero-content{position:relative;z-index:2;padding:120px 0 80px;display:flex;flex-direction:column;align-items:center;gap:26px}
.hero-logo-card{
  width:112px;height:112px;border-radius:28px;background:var(--logo-card);
  border:1px solid var(--border-strong);display:grid;place-items:center;
  box-shadow:0 0 60px rgba(255,122,26,.22),var(--shadow);
  animation:floaty 6s ease-in-out infinite;
}
.hero-logo-card img{width:80%;height:80%;object-fit:contain}
@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.hero-badge{
  display:inline-flex;align-items:center;gap:9px;padding:8px 18px;border-radius:99px;
  background:var(--panel);border:1px solid var(--border);backdrop-filter:blur(8px);
  font-size:.82rem;font-weight:600;color:var(--muted);letter-spacing:.04em;
}
.hero-badge .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent-glow);animation:pulse 2.2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.hero h1{font-size:clamp(2.3rem,6vw,4.3rem);font-weight:700;line-height:1.12;max-width:900px}
.hero h1 .grad{white-space:nowrap}
.hero-sub{max-width:560px;color:var(--muted);font-size:clamp(1rem,1.6vw,1.18rem)}
.hero-pre{color:var(--muted);font-size:clamp(.95rem,1.5vw,1.12rem);font-weight:500;letter-spacing:.02em}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-top:8px}
.btn{
  display:inline-flex;align-items:center;gap:10px;padding:15px 30px;border-radius:14px;
  font-weight:600;font-size:.98rem;transition:all .35s var(--ease);border:1px solid transparent;
}
.btn svg{width:17px;height:17px;transition:transform .35s var(--ease)}
html[dir="rtl"] .btn svg{transform:scaleX(-1)}
.btn-primary{background:linear-gradient(120deg,var(--accent),#ff9540);color:#fff;box-shadow:0 10px 32px rgba(255,122,26,.32)}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 16px 44px rgba(255,122,26,.45)}
.btn-primary:hover svg{transform:scaleX(-1) translateX(3px)}
html[dir="ltr"] .btn-primary:hover svg{transform:translateX(3px)}
.btn-ghost{background:var(--panel);border-color:var(--border);color:var(--text);backdrop-filter:blur(8px)}
.btn-ghost:hover{transform:translateY(-3px);border-color:var(--accent-glow);color:var(--accent)}
.hero-scroll{
  position:absolute;bottom:28px;inset-inline-start:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;color:var(--muted);
  font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;z-index:2;
}
.hero-scroll .line{width:1px;height:44px;background:linear-gradient(var(--accent),transparent);animation:drip 2s var(--ease) infinite}
@keyframes drip{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

/* ================= ABOUT ================= */
.about-wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center}
.about-statement{font-size:clamp(1.9rem,3.6vw,2.9rem);font-weight:700;line-height:1.2;margin:14px 0 20px}
.about-text{color:var(--muted)}
.about-text.lead{font-size:1.08rem;color:var(--text);margin-bottom:16px}
.about-feats{display:flex;flex-direction:column;gap:14px;margin-top:30px}
.feat{display:flex;gap:16px;padding:18px 20px;border-radius:var(--radius);background:var(--panel);border:1px solid var(--border);transition:all .35s var(--ease)}
.feat:hover{transform:translateX(6px);border-color:var(--accent-glow);background:var(--panel-2)}
html[dir="rtl"] .feat:hover{transform:translateX(-6px)}
.feat-ico{width:44px;height:44px;flex-shrink:0;border-radius:12px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent)}
.feat-ico svg{width:21px;height:21px}
.feat h4{font-size:1rem;margin-bottom:3px}
.feat p{font-size:.88rem;color:var(--muted)}
.about-visual{position:relative;display:grid;place-items:center;min-height:420px}
.about-visual .ring{position:absolute;border:1px solid var(--border);border-radius:50%}
.about-visual .r1{width:340px;height:340px;animation:spin 26s linear infinite}
.about-visual .r2{width:460px;height:460px;animation:spin 40s linear infinite reverse;border-style:dashed}
@keyframes spin{to{transform:rotate(360deg)}}
.about-visual .core{
  width:230px;height:230px;border-radius:32px;background:var(--logo-card);border:1px solid var(--border-strong);
  display:grid;place-items:center;box-shadow:0 0 80px rgba(255,122,26,.2),var(--shadow);
}
.about-visual .core img{width:78%;height:78%;object-fit:contain}
.about-chip{
  position:absolute;padding:10px 18px;border-radius:14px;font-size:.82rem;font-weight:600;
  background:var(--card);border:1px solid var(--border);box-shadow:var(--shadow);backdrop-filter:blur(10px);
  display:flex;align-items:center;gap:8px;animation:floaty 7s ease-in-out infinite;
}
.about-chip .dot{width:7px;height:7px;border-radius:50%;background:var(--accent)}
.about-chip.c1{top:8%;inset-inline-start:2%;animation-delay:.8s}
.about-chip.c2{bottom:10%;inset-inline-end:0;animation-delay:1.6s}
.about-chip.c3{top:52%;inset-inline-start:-4%;animation-delay:2.4s}

/* ================= SOLUTIONS ================= */
#solutions{background:var(--bg-2);border-block:1px solid var(--border)}
.solutions-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.sol-card{
  position:relative;overflow:hidden;padding:28px 24px;border-radius:var(--radius);
  background:var(--card);border:1px solid var(--border);
  transition:transform .4s var(--ease),border-color .4s,box-shadow .4s;
}
.sol-card::before{
  content:"";position:absolute;inset:0;opacity:0;transition:opacity .4s;
  background:radial-gradient(220px 160px at 30% 0%,var(--accent-soft),transparent 70%);
}
.sol-card:hover{transform:translateY(-7px);border-color:var(--accent-glow);box-shadow:0 18px 44px rgba(0,0,0,.22),0 0 0 1px var(--accent-soft)}
.sol-card:hover::before{opacity:1}
.sol-ico{
  width:52px;height:52px;border-radius:14px;display:grid;place-items:center;margin-bottom:18px;
  background:var(--accent-soft);color:var(--accent);
  transition:transform .4s var(--ease),box-shadow .4s;
}
.sol-card:hover .sol-ico{transform:scale(1.1) rotate(-4deg);box-shadow:0 0 24px var(--accent-glow)}
.sol-ico svg{width:25px;height:25px}
.sol-card h3{font-size:1.02rem;margin-bottom:7px}
.sol-card p{font-size:.86rem;color:var(--muted)}
.sol-num{position:absolute;top:18px;inset-inline-end:20px;font-family:'Space Grotesk',sans-serif;font-size:.75rem;font-weight:600;color:var(--muted);opacity:.55}

/* ================= PROJECTS ================= */
.case{
  border-radius:28px;overflow:hidden;
  background:linear-gradient(160deg,var(--panel-2),var(--panel));
  border:1px solid var(--border);box-shadow:var(--shadow);
}
.case-head{
  display:flex;align-items:center;gap:28px;flex-wrap:wrap;
  padding:44px 44px 36px;border-bottom:1px solid var(--border);
}
.client-card{
  width:120px;height:120px;flex-shrink:0;border-radius:24px;background:var(--client-card);
  border:1px solid var(--border-strong);display:grid;place-items:center;padding:16px;
  box-shadow:0 14px 40px rgba(0,0,0,.25);
}
.client-card img{width:100%;height:100%;object-fit:contain}
.case-head-text{flex:1;min-width:260px}
.case-tag{display:inline-flex;align-items:center;gap:8px;font-size:.76rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);margin-bottom:10px}
html[lang="ar"] .case-tag{letter-spacing:.04em}
.case-head-text h3{font-size:clamp(1.5rem,3vw,2.2rem);font-weight:700}
.case-head-text p{color:var(--muted);margin-top:8px;max-width:520px}
.chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:16px}
.chip{
  padding:7px 15px;border-radius:99px;font-size:.8rem;font-weight:600;
  background:var(--accent-soft);color:var(--accent);border:1px solid var(--accent-glow);
}
.case-body{padding:40px 44px 48px}

/* --- Slider --- */
.slider-shell{display:grid;grid-template-columns:1fr;gap:26px}
.slider{
  position:relative;border-radius:24px;overflow:hidden;aspect-ratio:16/9;max-height:640px;
  background:var(--bg-3);border:1px solid var(--border);
}
.slide{position:absolute;inset:0;opacity:0;transform:scale(1.045);transition:opacity .75s var(--ease),transform .95s var(--ease);pointer-events:none}
.slide.active{opacity:1;transform:scale(1);pointer-events:auto}
.slide img{width:100%;height:100%;object-fit:cover}
.slide-ph{
  position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;padding:24px;
  background:
    radial-gradient(500px 300px at 70% 20%,var(--accent-soft),transparent 70%),
    linear-gradient(160deg,var(--bg-3),var(--bg-2));
}
.slide-ph::before{
  content:"";position:absolute;inset:0;
  background-image:linear-gradient(var(--grid-line) 1px,transparent 1px),linear-gradient(90deg,var(--grid-line) 1px,transparent 1px);
  background-size:44px 44px;
  -webkit-mask-image:radial-gradient(circle at 50% 50%,#000 30%,transparent 80%);
  mask-image:radial-gradient(circle at 50% 50%,#000 30%,transparent 80%);
}
.slide-ph-ico{position:relative;width:88px;height:88px;border-radius:24px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent);box-shadow:0 0 40px var(--accent-glow)}
.slide-ph-ico svg{width:42px;height:42px}
.slide-ph h4{position:relative;font-size:1.2rem}
.slide-ph span{position:relative;font-size:.8rem;color:var(--muted)}
.slide-num-bg{position:absolute;bottom:-24px;inset-inline-end:14px;font-family:'Space Grotesk',sans-serif;font-size:9rem;font-weight:700;color:var(--text);opacity:.05;line-height:1;user-select:none}
.slider-arrow{
  position:absolute;top:50%;transform:translateY(-50%);z-index:5;
  width:52px;height:52px;border-radius:50%;display:grid;place-items:center;
  background:rgba(10,12,16,.55);border:1px solid rgba(255,255,255,.2);color:#fff;backdrop-filter:blur(10px);
  transition:all .3s var(--ease);
}
html[data-theme="light"] .slider-arrow{background:rgba(255,255,255,.75);border-color:rgba(13,18,26,.15);color:#141a22}
.slider-arrow:hover{background:var(--accent);border-color:var(--accent);color:#fff;transform:translateY(-50%) scale(1.07)}
.slider-arrow svg{width:20px;height:20px}
.slider-arrow.prev{inset-inline-start:18px}
.slider-arrow.next{inset-inline-end:18px}
html[dir="rtl"] .slider-arrow svg{transform:scaleX(-1)}

.slider-foot{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.slide-info{display:flex;align-items:center;gap:20px;flex:1;min-width:280px}
.info-ico{width:58px;height:58px;flex-shrink:0;border-radius:16px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent)}
.info-ico svg{width:27px;height:27px}
.info-txt h4{font-size:1.14rem;margin-bottom:4px}
.info-txt p{font-size:.9rem;color:var(--muted);max-width:560px}
.info-txt.swap h4{animation:rise .55s var(--ease) both}
.info-txt.swap p{animation:rise .55s .08s var(--ease) both}
.info-txt.swap .info-ico{animation:pop .5s var(--ease) both}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes pop{from{opacity:0;transform:scale(.75)}to{opacity:1;transform:scale(1)}}
.info-side{display:flex;flex-direction:column;align-items:flex-end;gap:10px}
html[dir="rtl"] .info-side{align-items:flex-start}
.cat-tag{padding:6px 14px;border-radius:99px;font-size:.74rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;background:var(--panel-2);border:1px solid var(--border);color:var(--muted)}
.slide-count{font-family:'Space Grotesk',sans-serif;font-size:.95rem;font-weight:600;color:var(--muted)}
.slide-count b{color:var(--accent);font-size:1.25rem}
.thumbs{display:flex;gap:10px;margin-top:6px}
.thumb{
  position:relative;width:86px;height:58px;border-radius:12px;overflow:hidden;flex-shrink:0;
  background:var(--bg-3);border:1px solid var(--border);display:grid;place-items:center;color:var(--muted);
  transition:all .3s var(--ease);
}
.thumb img{width:100%;height:100%;object-fit:cover}
.thumb svg{width:18px;height:18px}
.thumb:hover{transform:translateY(-3px);border-color:var(--border-strong)}
.thumb.on{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft),0 0 18px var(--accent-glow)}
.thumb i{position:absolute;bottom:4px;inset-inline-end:6px;font-style:normal;font-size:.6rem;font-weight:700;color:var(--muted)}

/* --- Solutions delivered stepper --- */
.steps{display:flex;align-items:center;gap:0;margin-top:38px;padding-top:32px;border-top:1px solid var(--border);flex-wrap:wrap}
.step{display:flex;align-items:center;gap:10px}
.step-dot{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent);font-size:.78rem;font-weight:700;font-family:'Space Grotesk',sans-serif}
.step span:last-child{font-size:.86rem;font-weight:600;color:var(--muted)}
.step-arrow{width:34px;height:1px;background:var(--border-strong);margin-inline:12px;position:relative}
.step-arrow::after{content:"";position:absolute;top:-3.5px;inset-inline-end:0;border:4px solid transparent;border-inline-start-color:var(--border-strong)}
.delivered-label{font-size:.78rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);margin-right:22px}
html[lang="ar"] .delivered-label{letter-spacing:.04em;margin-left:22px;margin-right:0}

.upcoming{margin-top:44px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.upcoming-label{font-size:.85rem;font-weight:600;color:var(--muted)}
.upcoming .chip{background:var(--panel);color:var(--muted);border-color:var(--border)}


/* ---------- Projects: sectors image ---------- */
.sectors-figure{border-radius:24px;overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow);background:var(--bg-3)}
.sectors-figure img{width:100%;height:auto;display:block}
@media (max-width:560px){
  .sectors-figure{border-radius:16px}
}

/* ---------- Projects directory: Categories → Projects ---------- */
#projectsStage{min-height:280px}
.stage-hint{color:var(--muted);font-size:.92rem;margin-bottom:22px}
.stage-anim{animation:stageIn .55s var(--ease) both}
@keyframes stageIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
.stage-top{position:sticky;top:calc(var(--header-h) + 12px);z-index:40;display:flex;align-items:center;gap:16px;margin-bottom:26px;flex-wrap:wrap;padding:10px 16px;border-radius:16px;background:var(--header-bg);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--border);box-shadow:0 8px 26px rgba(0,0,0,.14)}
.back-btn{padding:10px 20px;font-size:.88rem;background:var(--panel-2);border-color:var(--border-strong);border-radius:12px}
.back-btn svg{width:16px;height:16px;transition:transform .3s var(--ease)}
.back-btn:hover svg{transform:translateX(-4px)}
html[dir="rtl"] .back-btn svg{transform:scaleX(-1)}
html[dir="rtl"] .back-btn:hover svg{transform:scaleX(-1) translateX(-4px)}
.crumb.current{color:var(--accent)}
.crumbs{display:flex;align-items:center;gap:10px;font-size:.85rem;color:var(--muted);flex-wrap:wrap}
.crumb{background:none;border:none;color:var(--muted);font-weight:600;font-size:.85rem;padding:2px;transition:color .3s}
.crumb:hover{color:var(--accent)}
.crumb.current{color:var(--text)}
.crumb-sep{opacity:.45}

/* --- Category cards: image-first premium design --- */
.cat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}
.cat-card{
  position:relative;height:340px;border-radius:24px;overflow:hidden;cursor:pointer;isolation:isolate;
  border:1px solid var(--border);background:var(--bg-3);
  transition:transform .45s var(--ease),border-color .45s,box-shadow .45s;
}
.cat-card img.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform .9s var(--ease)}
.cat-card .overlay{position:absolute;inset:0;z-index:-1;
  background:linear-gradient(185deg,rgba(8,10,14,.08) 35%,rgba(8,10,14,.86) 95%);
  transition:opacity .45s}
.cat-card .overlay::after{content:"";position:absolute;inset:0;opacity:0;transition:opacity .45s;
  background:radial-gradient(320px 200px at 85% 12%,var(--accent-glow),transparent 70%)}
.cat-card.no-img{background:
  radial-gradient(400px 260px at 80% 0%,var(--accent-soft),transparent 70%),
  linear-gradient(160deg,var(--bg-3),var(--bg-2))}
.cat-card.no-img::before{content:"";position:absolute;inset:0;z-index:-2;
  background-image:linear-gradient(var(--grid-line) 1px,transparent 1px),linear-gradient(90deg,var(--grid-line) 1px,transparent 1px);
  background-size:40px 40px;
  -webkit-mask-image:radial-gradient(circle at 50% 40%,#000 30%,transparent 85%);
  mask-image:radial-gradient(circle at 50% 40%,#000 30%,transparent 85%)}
.cat-card:hover{transform:translateY(-7px);border-color:var(--accent-glow);box-shadow:0 22px 50px rgba(0,0,0,.3),0 0 0 1px var(--accent-soft)}
.cat-card:hover img.bg{transform:scale(1.07)}
.cat-card:hover .overlay::after{opacity:1}
.cat-badge{position:absolute;top:18px;inset-inline-start:18px;width:52px;height:52px;border-radius:15px;
  display:grid;place-items:center;font-size:1.55rem;
  background:rgba(10,12,16,.5);border:1px solid rgba(255,255,255,.28);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  transition:transform .45s var(--ease),box-shadow .45s}
.cat-card:hover .cat-badge{transform:scale(1.1) rotate(-5deg);box-shadow:0 0 26px var(--accent-glow)}
.cat-num-chip{position:absolute;top:22px;inset-inline-end:18px;padding:5px 13px;border-radius:99px;
  font-family:'Space Grotesk',sans-serif;font-size:.78rem;font-weight:600;color:#fff;
  background:rgba(10,12,16,.5);border:1px solid rgba(255,255,255,.22);backdrop-filter:blur(10px)}
.cat-info{position:absolute;bottom:0;inset-inline:0;padding:22px 24px;color:#fff}
.cat-info h3{color:#fff;font-size:1.28rem}
.cat-alt{display:block;font-size:.8rem;color:rgba(255,255,255,.72);font-weight:600;margin-top:2px}
.cat-desc{font-size:.84rem;color:rgba(255,255,255,.78);margin:10px 0 16px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.cat-foot{display:flex;align-items:center;justify-content:space-between;gap:10px}
.cat-count{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.05rem;color:#fff}
.cat-count span{color:rgba(255,255,255,.7);font-weight:500;font-size:.78rem}
.cat-go{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:#fff;
  background:linear-gradient(120deg,var(--accent),#ff9540);box-shadow:0 6px 18px rgba(255,122,26,.4);
  transition:transform .35s var(--ease),box-shadow .35s}
.cat-go svg{width:17px;height:17px}
.cat-card:hover .cat-go{transform:translateX(4px) scale(1.06);box-shadow:0 8px 26px rgba(255,122,26,.55)}
html[dir="rtl"] .cat-go svg{transform:scaleX(-1)}
html[dir="rtl"] .cat-card:hover .cat-go{transform:scaleX(-1) translateX(4px) scale(1.06)}

/* --- Category banner (inside category view) --- */
.cat-banner{position:relative;height:210px;border-radius:24px;overflow:hidden;margin-bottom:28px;
  border:1px solid var(--border);background:var(--bg-3)}
.cat-banner img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.cat-banner .overlay{position:absolute;inset:0;background:linear-gradient(185deg,rgba(8,10,14,.1) 30%,rgba(8,10,14,.88) 95%)}
.cat-banner.no-img{background:
  radial-gradient(460px 280px at 82% 0%,var(--accent-soft),transparent 70%),
  linear-gradient(160deg,var(--bg-3),var(--bg-2))}
.cat-banner-inner{position:absolute;bottom:0;inset-inline:0;padding:22px 26px;display:flex;align-items:flex-end;gap:16px;color:#fff;flex-wrap:wrap}
.cat-banner-inner h3{color:#fff;font-size:1.5rem}
.cat-banner-inner .cat-alt{color:rgba(255,255,255,.72)}
.cat-banner-inner p{color:rgba(255,255,255,.8);font-size:.86rem;max-width:560px;margin-top:4px}
.cat-banner-inner .cat-count{margin-inline-start:auto}

/* --- Project cards inside a category --- */
.proj-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:18px}
.proj-card{
  display:flex;flex-direction:column;gap:10px;padding:18px;border-radius:20px;cursor:pointer;
  background:var(--card);border:1px solid var(--border);
  transition:transform .4s var(--ease),border-color .4s,box-shadow .4s;
}
.proj-card:hover{transform:translateY(-6px);border-color:var(--accent-glow);box-shadow:0 18px 44px rgba(0,0,0,.22),0 0 0 1px var(--accent-soft)}
.proj-cover{position:relative;height:140px;border-radius:13px;overflow:hidden;background:var(--bg-3);display:grid;place-items:center;margin-bottom:4px}
.proj-cover img{width:100%;height:100%;object-fit:cover;transition:transform .7s var(--ease)}
.proj-card:hover .proj-cover img{transform:scale(1.06)}
.proj-cover-fallback{font-size:2rem;opacity:.9}
.proj-cover::after{content:"";position:absolute;inset:0;background:linear-gradient(185deg,transparent 55%,rgba(8,10,14,.35))}
.proj-card h4{font-size:1rem}
.proj-card>p{font-size:.84rem;color:var(--muted);flex:1}
.proj-chips{display:flex;flex-wrap:wrap;gap:6px}
.proj-chips i{font-style:normal;font-size:.72rem;font-weight:600;padding:4px 10px;border-radius:99px;background:var(--accent-soft);color:var(--accent)}
.proj-link{display:inline-flex;align-items:center;gap:7px;color:var(--accent);font-weight:600;font-size:.88rem;margin-top:4px}
.proj-link svg{width:16px;height:16px;transition:transform .3s var(--ease)}
.proj-card:hover .proj-link svg{transform:translateX(4px)}
html[dir="rtl"] .proj-link svg{transform:scaleX(-1)}
html[dir="rtl"] .proj-card:hover .proj-link svg{transform:scaleX(-1) translateX(4px)}


/* ---------- Contact Section ---------- */
.contact-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:44px;align-items:start}
.contact-info-card{padding:36px;border-radius:24px;background:var(--card);border:1px solid var(--border);box-shadow:var(--shadow)}
.contact-info-card h3{font-size:1.35rem;margin-bottom:22px}
.contact-list{display:flex;flex-direction:column;gap:14px}
.contact-row{display:flex;align-items:center;gap:16px;padding:18px 20px;border-radius:16px;background:var(--panel);border:1px solid var(--border);transition:all .35s var(--ease);cursor:pointer;text-decoration:none}
.contact-row:hover{transform:translateX(6px);border-color:var(--accent-glow);background:var(--panel-2)}
html[dir="rtl"] .contact-row:hover{transform:translateX(-6px)}
.contact-row .ci-ico{width:48px;height:48px;flex-shrink:0;border-radius:14px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent);transition:transform .4s var(--ease),box-shadow .4s}
.contact-row:hover .ci-ico{transform:scale(1.1);box-shadow:0 0 22px var(--accent-glow)}
.contact-row .ci-ico svg{width:22px;height:22px}
.contact-row .ci-body{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.contact-row .ci-label{display:block;font-size:.76rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}
.contact-row .ci-value{display:block;font-size:1.02rem;font-weight:600;color:var(--text);direction:ltr;text-align:start;line-height:1.3}
.contact-row.wa .ci-ico{background:rgba(37,211,102,.12);color:#25d366}
.contact-row.wa:hover .ci-ico{box-shadow:0 0 22px rgba(37,211,102,.35)}
.contact-row.email .ci-ico{background:rgba(59,130,246,.12);color:#3b82f6}
.contact-row.email:hover .ci-ico{box-shadow:0 0 22px rgba(59,130,246,.35)}
.contact-socials{display:flex;gap:12px;margin-top:24px}
.contact-socials a{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;background:var(--panel);border:1px solid var(--border);color:var(--muted);transition:all .35s var(--ease)}
.contact-socials a:hover{color:var(--accent);border-color:var(--accent-glow);transform:translateY(-3px);box-shadow:0 8px 22px rgba(0,0,0,.18)}
.contact-socials a svg{width:20px;height:20px}
.contact-cta-card{padding:36px;border-radius:24px;background:linear-gradient(160deg,var(--panel-2),var(--panel));border:1px solid var(--border);position:relative;overflow:hidden}
.contact-cta-card::before{content:"";position:absolute;inset:0;background:radial-gradient(400px 220px at 80% 0%,var(--accent-soft),transparent 70%);pointer-events:none}
.contact-cta-card h3{position:relative;font-size:1.35rem;margin-bottom:12px}
.contact-cta-card>p{position:relative;color:var(--muted);margin-bottom:24px}
.contact-cta-card .btn{position:relative;width:100%;justify-content:center;margin-bottom:10px}
.contact-cta-card .btn-wa{background:linear-gradient(120deg,#25d366,#128c7e);color:#fff;box-shadow:0 10px 32px rgba(37,211,102,.28)}
.contact-cta-card .btn-wa:hover{transform:translateY(-3px);box-shadow:0 16px 44px rgba(37,211,102,.4)}
.contact-cta-card .btn-call{background:var(--panel);border-color:var(--border);color:var(--text)}
.contact-cta-card .btn-call:hover{border-color:var(--accent-glow);color:var(--accent)}
.contact-cta-card .btn-email{background:var(--panel);border-color:var(--border);color:var(--text)}
.contact-cta-card .btn-email:hover{border-color:rgba(59,130,246,.4);color:#3b82f6}

/* ---------- Floating WhatsApp ---------- */
.fab-wa{position:fixed;inset-inline-end:24px;bottom:28px;z-index:90;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,#25d366,#128c7e);box-shadow:0 6px 24px rgba(37,211,102,.45);transition:transform .35s var(--ease),box-shadow .35s;animation:waPulse 3s ease-in-out infinite}
.fab-wa:hover{transform:scale(1.1) translateY(-3px);box-shadow:0 10px 34px rgba(37,211,102,.6)}
.fab-wa svg{width:28px;height:28px}
@keyframes waPulse{0%,100%{box-shadow:0 6px 24px rgba(37,211,102,.45)}50%{box-shadow:0 6px 32px rgba(37,211,102,.7)}}

.no-gallery{display:flex;align-items:center;justify-content:center;gap:14px;padding:32px;border-radius:18px;background:var(--panel);border:1px dashed var(--border-strong);color:var(--muted);font-size:.92rem;margin-bottom:8px}
.no-gallery .ng-ico{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:var(--accent-soft);color:var(--accent)}
.no-gallery .ng-ico svg{width:22px;height:22px}

/* ================= CONTACT ================= *//* ================= CONTACT ================= */
#contact{background:var(--bg-2);border-top:1px solid var(--border)}
.contact-card{
  position:relative;overflow:hidden;text-align:center;border-radius:30px;padding:80px 32px;
  background:linear-gradient(160deg,var(--panel-2),var(--panel));border:1px solid var(--border);
}
.contact-card::before{content:"";position:absolute;inset:0;background:radial-gradient(500px 260px at 50% 0%,var(--accent-soft),transparent 70%);pointer-events:none}
.contact-card h2{font-size:clamp(1.9rem,4vw,3rem);font-weight:700;margin:14px 0 12px;position:relative}
.contact-card>p{color:var(--muted);position:relative;max-width:480px;margin:0 auto}
.contact-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:34px;position:relative}
.contact-info{display:flex;gap:34px;justify-content:center;flex-wrap:wrap;margin-top:44px;position:relative}
.ci{display:flex;align-items:center;gap:10px;font-size:.92rem;color:var(--muted)}
.ci svg{width:17px;height:17px;color:var(--accent)}
.ci b{color:var(--text);font-weight:600}
.socials{display:flex;gap:10px;justify-content:center;margin-top:26px;position:relative}

/* ================= FOOTER ================= */
.footer{border-top:1px solid var(--border);padding:64px 0 34px;background:var(--bg)}
.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.1fr;gap:44px}
.footer .logo-card{width:52px;height:52px;margin-bottom:16px}
.footer-desc{color:var(--muted);font-size:.9rem;max-width:300px}
.footer h5{font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;color:var(--text);margin-bottom:16px}
html[lang="ar"] .footer h5{letter-spacing:.04em}
.footer-links{display:flex;flex-direction:column;gap:10px}
.footer-links a{font-size:.9rem;color:var(--muted);transition:color .3s,transform .3s;width:fit-content}
.footer-links a:hover{color:var(--accent);transform:translateX(3px)}
html[dir="rtl"] .footer-links a:hover{transform:translateX(-3px)}
.footer-bottom{margin-top:52px;padding-top:24px;border-top:1px solid var(--border);display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.82rem;color:var(--muted)}

/* ================= RESPONSIVE ================= */
@media (max-width:860px){
  .contact-grid{grid-template-columns:1fr;gap:22px}
}
@media (max-width:1024px){
  .solutions-grid{grid-template-columns:repeat(3,1fr)}
  .about-wrap{grid-template-columns:1fr;gap:48px}
  .about-visual{min-height:380px}
  .footer-grid{grid-template-columns:1fr 1fr}
}
@media (max-width:860px){
  .nav{display:none}
  .nav-toggle{display:grid}
  .logo-name span{display:none}
  .solutions-grid{grid-template-columns:repeat(2,1fr)}
  .case-head,.case-body{padding-inline:24px}
  .case-head{padding-top:32px}
  .slider{aspect-ratio:4/3}
  .slider-arrow{width:44px;height:44px;inset-inline-start:12px}
  .slider-arrow.next{inset-inline-end:12px}
  .slide-info{flex-direction:row}
  .steps{gap:10px}
  .step-arrow{display:none}
  .step{flex-basis:45%}
}
@media (max-width:560px){
  .section{padding:78px 0}
  .solutions-grid{grid-template-columns:1fr}
  .hero-logo-card{width:92px;height:92px;border-radius:22px}
  .case-head{gap:18px}
  .client-card{width:92px;height:92px}
  .slide-info{flex-direction:column;align-items:flex-start}
  .info-side{flex-direction:row;width:100%;justify-content:space-between;align-items:center}
  .thumbs{width:100%;overflow-x:auto;padding-bottom:4px}
  .footer-grid{grid-template-columns:1fr}
  .slide-num-bg{font-size:6rem}
}
</style>
</head>
<body>

<!-- ================= HEADER ================= -->
<header class="header" id="header">
  <div class="container header-inner">
    <a href="#home" class="logo-badge" aria-label="Elshazly Technology">
      <span class="logo-card"><img src="data:image/png;base64," alt="Elshazly Technology logo"></span>
      <span class="logo-name"><b>Elshazly Technology</b><span data-i18n="brand.tag">Tech &amp; Security</span></span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="#home" data-i18n="nav.home" data-sec="home">Home</a>
      <a href="#about" data-i18n="nav.about" data-sec="about">About</a>
      <a href="#solutions" data-i18n="nav.solutions" data-sec="solutions">Solutions</a>
      <a href="#projects" data-i18n="nav.projects" data-sec="projects">Projects</a>
      <a href="#contact" data-i18n="nav.contact" data-sec="contact">Contact</a>
    </nav>
    <div class="header-tools">
      <div class="header-socials" id="headerSocials" style="display:flex;align-items:center;gap:6px"></div>
      <div class="lang-switch" role="group" aria-label="Language">
        <button id="langEn" type="button">EN</button>
        <button id="langAr" type="button">ع</button>
      </div>
      <button class="icon-btn" id="themeBtn" type="button" aria-label="Toggle theme">
        <svg id="iconMoon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg id="iconSun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="icon-btn nav-toggle" id="navToggle" type="button" aria-label="Open menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  <a href="#home" data-i18n="nav.home">Home</a>
  <a href="#about" data-i18n="nav.about">About</a>
  <a href="#solutions" data-i18n="nav.solutions">Solutions</a>
  <a href="#projects" data-i18n="nav.projects">Projects</a>
  <a href="#contact" data-i18n="nav.contact">Contact</a>
</div>

<main id="main">

<!-- ================= HERO ================= -->
<section class="hero" id="home">
  <canvas id="netCanvas" aria-hidden="true"></canvas>
