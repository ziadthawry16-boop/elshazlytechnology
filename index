const $  = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
let LANG;
try{ LANG = localStorage.getItem('et-lang'); }catch(_){}
if(LANG!=='ar' && LANG!=='en') LANG = (navigator.language||'').toLowerCase().startsWith('ar') ? 'ar' : 'en';
const T = () => I18N[LANG];

/* ---------- Language ---------- */
function applyI18n(){
  $$('[data-i18n]').forEach(el=>{ const k=el.dataset.i18n; if(T()[k]!=null) el.textContent=T()[k]; });
  $$('[data-i18n-html]').forEach(el=>{ const k=el.dataset.i18nHtml; if(T()[k]!=null) el.innerHTML=T()[k]; });
  document.documentElement.lang = LANG;
  document.documentElement.dir  = LANG==='ar' ? 'rtl' : 'ltr';
  document.title = T()['meta.title'];
  $('#langEn').classList.toggle('on', LANG==='en');
  $('#langAr').classList.toggle('on', LANG==='ar');
  renderServices(); renderFooterServices(); renderProjects(); renderContact();
}
function setLang(lang){
  if(lang===LANG) return;
  const main = $('#main');
  try{ LANG = lang; try{ localStorage.setItem('et-lang', lang); }catch(_){} }catch(_){}
  try{
    if(main){ main.style.transition='opacity .28s ease'; main.style.opacity='0'; }
    setTimeout(()=>{
      try{ applyI18n(); }catch(err){ console.error('i18n:', err); }
      requestAnimationFrame(()=>{ if(main) main.style.opacity='1'; });
    }, 280);
  }catch(err){
    console.error('setLang:', err);
    if(main){ main.style.transition=''; main.style.opacity='1'; }
  }
}
$('#langEn').addEventListener('click',()=>setLang('en'));
$('#langAr').addEventListener('click',()=>setLang('ar'));

/* ---------- Theme ---------- */
function setTheme(theme, save=true){
  document.documentElement.dataset.theme = theme;
  $('#iconMoon').style.display = theme==='dark' ? '' : 'none';
  $('#iconSun').style.display  = theme==='dark' ? 'none' : '';
  if(save){ try{ localStorage.setItem('et-theme', theme); }catch(_){} }
}
$('#themeBtn').addEventListener('click',()=>{
  setTheme(document.documentElement.dataset.theme==='dark' ? 'light' : 'dark');
});
setTheme(localStorage.getItem('et-theme') || 'dark', false);

