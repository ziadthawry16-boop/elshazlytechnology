/* reveal on scroll */
const revObs=new IntersectionObserver(es=>{
  es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); revObs.unobserve(e.target); } });
},{threshold:.14});
$$('.reveal').forEach(el=>revObs.observe(el));

/* hero canvas — elegant connected nodes */
(function(){
  const cv=$('#netCanvas'), ctx=cv.getContext('2d');
  const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W,H,nodes=[],visible=true;
  function resize(){
    W=cv.width=cv.offsetWidth*devicePixelRatio; H=cv.height=cv.offsetHeight*devicePixelRatio;
    const n=Math.min(85,Math.floor(W/22/devicePixelRatio));
    nodes=Array.from({length:n},()=>({
      x:Math.random()*W, y:Math.random()*H,
      vx:(Math.random()-.5)*.22*devicePixelRatio, vy:(Math.random()-.5)*.22*devicePixelRatio,
      r:(Math.random()*1.4+.8)*devicePixelRatio
    }));
  }
  function themeColors(){
    const light=document.documentElement.dataset.theme==='light';
    return { dot: light?'rgba(20,26,34,':'rgba(220,228,240,', line: light?'rgba(255,122,26,':'rgba(255,138,60,' };
  }
  function frame(){
    if(visible){
      const c=themeColors();
      ctx.clearRect(0,0,W,H);
      const max=150*devicePixelRatio;
      for(let i=0;i<nodes.length;i++){
        const a=nodes[i];
        a.x+=a.vx; a.y+=a.vy;
        if(a.x<0||a.x>W)a.vx*=-1; if(a.y<0||a.y>H)a.vy*=-1;
        for(let j=i+1;j<nodes.length;j++){
          const b=nodes[j],dx=a.x-b.x,dy=a.y-b.y,d=Math.hypot(dx,dy);
          if(d<max){ ctx.strokeStyle=c.line+((1-d/max)*.14)+')'; ctx.lineWidth=devicePixelRatio*.7;
            ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke(); }
        }
        ctx.fillStyle=c.dot+'.5)';
        ctx.beginPath();ctx.arc(a.x,a.y,a.r,0,7);ctx.fill();
      }
    }
    if(!reduce) requestAnimationFrame(frame);
  }
  resize(); addEventListener('resize',resize);
  new IntersectionObserver(e=>{visible=e[0].isIntersecting;}).observe(cv);
  frame();
})();

